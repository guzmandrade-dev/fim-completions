{
  "name": "fim-completions",
  "displayName": "FIM Completions",
  "version": "0.1.0",
  "description": "Minimal inline code completions using a custom FIM model via /api/generate",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Machine Learning",
    "Snippets"
  ],
  "keywords": [
    "ai",
    "autocomplete",
    "completion",
    "fim",
    "inline",
    "llm"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "tsup",
    "watch": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "contributes": {
    "configuration": {
      "title": "FIM Completions",
      "properties": {
        "fim.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline FIM completions using rnj-1 model."
        },
        "fim.apiUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Base URL of the Ollama API endpoint."
        },
        "fim.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for authenticated requests (required for Ollama cloud services)."
        },
        "fim.maxTokens": {
          "type": "number",
          "default": 128,
          "description": "Maximum number of tokens to generate per completion."
        }
      }
    }
  },
  "dependencies": {
    "ollama": "^0.6.3"
  }
}
